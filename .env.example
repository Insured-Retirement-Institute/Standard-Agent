# ============================================================================
# IRI Standards Agent — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The agent uses any OpenAI-compatible API. Choose ONE of the options below.
# ============================================================================

# --- Option A: OpenAI (default) ---
# Sign up at https://platform.openai.com and create an API key.
OPENAI_API_KEY=sk-...your-key-here...
MODEL_ID=gpt-4o

# --- Option B: Azure OpenAI ---
# OPENAI_API_KEY=your-azure-api-key
# OPENAI_BASE_URL=https://your-resource.openai.azure.com/openai/deployments/your-deployment
# MODEL_ID=your-deployment-name

# --- Option C: Anthropic via OpenAI-compatible proxy ---
# OPENAI_API_KEY=sk-ant-...
# OPENAI_BASE_URL=https://your-proxy-url/v1
# MODEL_ID=claude-sonnet-4-20250514

# --- Option D: Databricks (external access token) ---
# Generate a personal access token at: https://your-workspace.databricks.net → User Settings → Developer → Access Tokens
# OPENAI_API_KEY=dapi...your-token...
# OPENAI_BASE_URL=https://your-workspace.databricks.net/serving-endpoints
# MODEL_ID=databricks-claude-sonnet-4

# --- Server ---
PORT=8000
